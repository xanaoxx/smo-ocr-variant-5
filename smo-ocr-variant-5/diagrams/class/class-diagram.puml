@startuml
title Вариант 5 — диаграмма классов центра OCR-обработки
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #236B8E
skinparam ClassBorderColor #236B8E
skinparam ClassBackgroundColor #EAF4FA

package "Модель" {
  class Request {
    - id: long
    - sourceId: int
    - documentUri: String
    - ocrParameters: String
    - arrivalTime: double
    - serviceStartTime: double
    - serviceEndTime: double
    - status: RequestStatus
    + getId(): long
    + getSourceId(): int
    + getArrivalTime(): double
    + startService(time: double): void
    + finishService(time: double): void
    + markEvicted(): void
    + getWaitingTime(): double
    + getServiceTime(): double
  }

  enum RequestStatus {
    WAITING
    IN_SERVICE
    COMPLETED
    EVICTED
  }

  class Batch {
    - sourceId: int
    - pending: Queue<Request>
    - totalCount: int
    - completedCount: int
    - createdAt: double
    + poll(): Request
    + hasPending(): boolean
    + onRequestCompleted(): void
    + isFullyProcessed(): boolean
    + getSourceId(): int
  }

  class RingBuffer {
    - cells: Request[]
    - pointer: int
    - capacity: int
    + put(request: Request): PutResult
    + waitingSourceIds(): Set<Integer>
    + takeAllCurrentlyWaiting(sourceId: int): List<Request>
    + isEmpty(): boolean
    + isFull(): boolean
    + snapshot(): Request[]
    + getPointer(): int
    - nextIndex(index: int): int
  }

  class PutResult {
    - stored: boolean
    - cellIndex: int
    - evictedRequest: Request
    + isStored(): boolean
    + isEvicted(): boolean
    + getCellIndex(): int
    + getEvictedRequest(): Request
  }

  class SystemState {
    - time: double
    - lastEvent: Event
    - bufferSnapshot: Request[]
    - bufferPointer: int
    - activeBatch: Batch
    - serverStates: List<String>
    - counters: SummaryTable
    + getTime(): double
  }

  class SummaryTable {
    - generatedCount: int
    - acceptedCount: int
    - evictedCount: int
    - completedCount: int
    - evictionRatio: double
    - averageWaitingTime: double
    - averageServiceTime: double
    - serverUtilization: Map<Integer, Double>
    + toTable(): String
  }
}

package "Источники и случайные законы" {
  class Source {
    - id: int
    - priority: int
    - nextRequestId: long
    - arrivalLaw: ArrivalLaw
    - calendar: EventCalendar
    + generateRequest(time: double): Request
    + scheduleNext(time: double): void
    + getId(): int
    + getPriority(): int
  }

  interface ArrivalLaw {
    + nextInterval(): double
  }

  class ExponentialInterarrivalLaw {
    - lambda: double
    + nextInterval(): double
  }

  interface ServiceTimeLaw {
    + nextDuration(): double
  }

  class UniformServiceTimeLaw {
    - minDuration: double
    - maxDuration: double
    + nextDuration(): double
  }
}

package "Диспетчеризация" {
  class PlacementDispatcher {
    - buffer: RingBuffer
    - batchScheduler: BatchScheduler
    - statistics: Statistics
    + onRequestGenerated(request: Request, time: double): void
    - place(request: Request, time: double): PutResult
  }

  class BatchScheduler {
    - buffer: RingBuffer
    - serverDispatcher: ServerDispatcher
    - statistics: Statistics
    - sourcePriorities: Map<Integer, Integer>
    - activeBatch: Batch
    + onRequestBuffered(time: double): void
    + onServerReleased(request: Request, time: double): void
    + dispatchAvailable(time: double): void
    + getActiveBatch(): Batch
    - chooseSourceId(candidates: Set<Integer>): int
    - createBatch(sourceId: int, time: double): Batch
  }

  class ServerDispatcher {
    - servers: List<OCRServer>
    - serviceTimeLaw: ServiceTimeLaw
    - calendar: EventCalendar
    - statistics: Statistics
    + hasFreeServer(): boolean
    + findFirstFreeServer(): OCRServer
    + dispatch(request: Request, time: double): boolean
  }

  class OCRServer {
    - number: int
    - currentRequest: Request
    - busyTime: double
    + getNumber(): int
    + isFree(): boolean
    + startService(request: Request, time: double, duration: double): void
    + finishService(time: double): Request
    + getBusyTime(): double
  }
}

package "События и наблюдение" {
  class Event {
    - time: double
    - type: EventType
    - source: Source
    - server: OCRServer
    + getTime(): double
    + getType(): EventType
    + getSource(): Source
    + getServer(): OCRServer
  }

  enum EventType {
    REQUEST_GENERATED
    SERVICE_COMPLETED
  }

  class EventCalendar {
    - events: PriorityQueue<Event>
    - currentTime: double
    + schedule(event: Event): void
    + next(): Event
    + isEmpty(): boolean
    + getCurrentTime(): double
  }

  class Statistics {
    - generatedCount: int
    - acceptedCount: int
    - evictedCount: int
    - completedCount: int
    - totalWaitingTime: double
    - totalServiceTime: double
    + registerGenerated(request: Request): void
    + registerAccepted(request: Request): void
    + registerEvicted(request: Request, time: double): void
    + registerStarted(request: Request, server: OCRServer): void
    + registerCompleted(request: Request, time: double): void
    + buildSummary(endTime: double): SummaryTable
  }

  class StepView {
    + show(state: SystemState): void
    + showSummary(summary: SummaryTable): void
  }

  class SimulationController {
    - calendar: EventCalendar
    - sources: List<Source>
    - buffer: RingBuffer
    - placementDispatcher: PlacementDispatcher
    - batchScheduler: BatchScheduler
    - serverDispatcher: ServerDispatcher
    - statistics: Statistics
    - view: StepView
    + initialize(): void
    + step(): SystemState
    + runAuto(endTime: double): SummaryTable
    - handleEvent(event: Event): void
    - buildState(event: Event): SystemState
  }
}

ArrivalLaw <|.. ExponentialInterarrivalLaw
ServiceTimeLaw <|.. UniformServiceTimeLaw

Source --> "1" ArrivalLaw : ИЗ1
Source --> "1" EventCalendar : планирует поступления
Source ..> Request : создаёт

PlacementDispatcher --> "1" RingBuffer : Д1ОЗ1 / Д1ОО1
PlacementDispatcher --> "1" BatchScheduler : onRequestBuffered
PlacementDispatcher --> "1" Statistics : учёт приёма и вытеснения
PlacementDispatcher ..> PutResult : получает

RingBuffer "1" o-- "0..*" Request : ячейки
RingBuffer ..> PutResult : возвращает

BatchScheduler --> "1" RingBuffer : выборка заявок источника
BatchScheduler --> "1" ServerDispatcher : dispatch
BatchScheduler --> "1" Statistics
BatchScheduler "1" o-- "0..1" Batch : активный пакет (Д2Б5)
Batch "1" o-- "1..*" Request : состав зафиксирован

ServerDispatcher "1" o-- "1..*" OCRServer : перебор по номерам (Д2П1)
ServerDispatcher --> "1" ServiceTimeLaw : ПЗ2
ServerDispatcher --> "1" EventCalendar : SERVICE_COMPLETED
ServerDispatcher --> "1" Statistics : registerStarted
OCRServer --> "0..1" Request : обслуживает

Request --> RequestStatus
EventCalendar "1" o-- "0..*" Event
Event --> EventType
Event --> "0..1" Source
Event --> "0..1" OCRServer

SimulationController *-- EventCalendar
SimulationController *-- RingBuffer
SimulationController *-- PlacementDispatcher
SimulationController *-- BatchScheduler
SimulationController *-- ServerDispatcher
SimulationController *-- Statistics
SimulationController *-- StepView
SimulationController o-- "1..*" Source
SimulationController ..> SystemState : ОД2
SimulationController ..> SummaryTable : ОР1
Statistics ..> SummaryTable : создаёт
StepView ..> SystemState : показывает
SystemState --> "0..1" Batch
@enduml
