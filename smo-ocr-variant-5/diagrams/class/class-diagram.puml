@startuml
title Вариант 5 — диаграмма классов центра OCR-обработки

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #236B8E
skinparam ClassBorderColor #236B8E
skinparam ClassBackgroundColor #EAF4FA

package "Модель" {

  class Request {
    - id: String
    - sourceId: int
    - documentUri: String
    - ocrParameters: String
    - arrivalTime: double
    - status: RequestStatus
    - serviceStartTime: Optional<double>
    - serviceEndTime: Optional<double>
    - bufferedTime: Optional<double>
    - slotIndex: Optional<int>
    - insertionOrder: int
    - rejectedTime: Optional<double>
    - serverNumber: Optional<int>
    - batchNumber: Optional<int>
    + getId(): String
    + getSourceId(): int
    + getArrivalTime(): double
    + startService(time: double): void
    + finishService(time: double): void
    + markEvicted(): void
    + getWaitingTime(): Optional<double>
    + getServiceTime(): Optional<double>
  }

  enum RequestStatus {
    WAITING
    IN_SERVICE
    COMPLETED
    EVICTED
  }

  class Batch {
    - sourceId: int
    - pending: Deque<Request>
    - totalCount: int
    - completedCount: int
    - createdAt: double
    - number: int
    - running: Set<String>
    - completedIds: List<String>
    - fixedIds: Tuple<String>
    + __post_init__(): void
    + poll(): Optional<Request>
    + hasPending(): boolean
    + onRequestCompleted(request: Request): void
    + isFullyProcessed(): boolean
    + getSourceId(): int
  }

  class RingBuffer {
    - cells: List<Optional<Request>>
    - pointer: int
    - capacity: int
    - _insertionSequence: count
    + put(request: Request): PutResult
    + waitingSourceIds(): Set<int>
    + takeAllCurrentlyWaiting(sourceId: int): List<Request>
    + isEmpty(): boolean
    + isFull(): boolean
    + snapshot(): Tuple<Optional<Request>>
    + getPointer(): int
    + nextIndex(index: int): int
  }

  class PutResult {
    - stored: boolean
    - cellIndex: int
    - evictedRequest: Optional<Request>
    + isStored(): boolean
    + isEvicted(): boolean
    + getCellIndex(): int
    + getEvictedRequest(): Optional<Request>
  }

  class SummaryTable {
    - generatedCount: int
    - acceptedCount: int
    - evictedCount: int
    - completedCount: int
    - evictionRatio: double
    - averageWaitingTime: double
    - averageServiceTime: double
    - serverUtilization: Dict<int, double>
    - sourceRows: List<Dict>
    - serverRows: List<Dict>
    - duration: double
    + toTable(): String
  }

  class SystemState {
    - time: double
    - lastEvent: String
    - bufferSnapshot: List<Dict>
    - bufferPointer: int
    - activeBatch: Optional<Dict>
    - serverStates: List<Dict>
    - counters: SummaryTable
    - sources: List<Dict>
    - generatedCount: int
    - acceptedCount: int
    - evictedCount: int
    - completedCount: int
    + getTime(): double
  }
}

package "Источники и случайные законы" {

  class Source {
    - id: int
    - priority: int
    - nextRequestId: int
    - arrivalLaw: ArrivalLaw
    - calendar: EventCalendar
    - generatedCount: int
    + generateRequest(time: double): Request
    + scheduleNext(time: double): void
    + getId(): int
    + getPriority(): int
  }

  class ArrivalLaw {
    + nextInterval(): double
  }

  class ExponentialInterarrivalLaw {
    - lambda_: double
    - random: Random
    + nextInterval(): double
  }

  class ServiceTimeLaw {
    + nextDuration(): double
  }

  class UniformServiceTimeLaw {
    - minDuration: double
    - maxDuration: double
    - random: Random
    + nextDuration(): double
  }
}

package "Конфигурация" {

  class Config {
    + arrivalRates: Tuple<double>
    + workers: int
    + capacity: int
    + serviceA: double
    + serviceB: double
    + requestLimit: int
    + seed: int
    + __post_init__(): void
  }
}

package "Диспетчеризация" {

  class PlacementDispatcher {
    - buffer: RingBuffer
    - batchScheduler: BatchScheduler
    - statistics: Statistics
    + onRequestGenerated(request: Request, time: double): PutResult
    + place(request: Request, time: double): PutResult
  }

  class BatchScheduler {
    - buffer: RingBuffer
    - serverDispatcher: ServerDispatcher
    - statistics: Statistics
    - sourcePriorities: Dict<int, int>
    - activeBatch: Optional<Batch>
    - lastBatch: Optional<Batch>
    - _batchSequence: count
    + onRequestBuffered(time: double): void
    + onServerReleased(request: Request, time: double): void
    + dispatchAvailable(time: double): void
    + chooseSourceId(candidates: Set<int>): Optional<int>
    + createBatch(sourceId: int, time: double): Batch
    + getActiveBatch(): Optional<Batch>
  }

  class ServerDispatcher {
    - servers: List<OCRServer>
    - serviceTimeLaw: ServiceTimeLaw
    - calendar: EventCalendar
    - statistics: Statistics
    + hasFreeServer(): boolean
    + findFirstFreeServer(): Optional<OCRServer>
    + dispatch(request: Request, time: double): boolean
  }

  class OCRServer {
    - number: int
    - currentRequest: Optional<Request>
    - busyTime: double
    - serviceStartTime: Optional<double>
    - busyUntil: Optional<double>
    - completedCount: int
    + getNumber(): int
    + isFree(): boolean
    + startService(request: Request, time: double, duration: double): void
    + finishService(time: double): Request
    + getBusyTime(): double
  }
}

package "События и наблюдение" {

  class Event {
    - time: double
    - priority: int
    - sequence: int
    - type: EventType
    - source: Optional<Source>
    - server: Optional<OCRServer>
    - requestId: Optional<String>
    + getTime(): double
    + getType(): EventType
    + getSource(): Optional<Source>
    + getServer(): Optional<OCRServer>
  }

  enum EventType {
    SERVICE_COMPLETED
    REQUEST_GENERATED
  }

  class EventCalendar {
    - events: List<Event>
    - currentTime: double
    - _sequence: count
    + schedule(event: Event): void
    + createEvent(time: double, eventType: EventType, source: Optional<Source>, server: Optional<OCRServer>, requestId: Optional<String>): Event
    + next(): Event
    + isEmpty(): boolean
    + getCurrentTime(): double
    + cancelFutureArrivals(): void
  }

  class Statistics {
    - generatedCount: int
    - acceptedCount: int
    - evictedCount: int
    - completedCount: int
    - totalWaitingTime: double
    - totalServiceTime: double
    - startedCount: int
    - serverStarts: Dict<int, int>
    - requests: List<Request>
    - sources: List<Source>
    - servers: List<OCRServer>
    + registerGenerated(request: Request): void
    + registerAccepted(request: Request): void
    + registerEvicted(request: Request, time: double): void
    + registerStarted(request: Request, server: OCRServer): void
    + registerCompleted(request: Request, time: double): void
    + buildSummary(endTime: double): SummaryTable
  }

  class StepView {
    + show(state: SystemState): void
    + showSummary(summary: SummaryTable): void
  }

  class SimulationController {
    - config: Config
    - view: StepView
    - calendar: EventCalendar
    - random: Random
    - sources: List<Source>
    - buffer: RingBuffer
    - servers: List<OCRServer>
    - statistics: Optional<Statistics>
    - placementDispatcher: Optional<PlacementDispatcher>
    - batchScheduler: Optional<BatchScheduler>
    - serverDispatcher: Optional<ServerDispatcher>
    - time: double
    - lastEvent: String
    - done: boolean
    - _initialized: boolean
    + initialize(): void
    + step(): SystemState
    + handleEvent(event: Event): void
    + buildState(): SystemState
    + runAuto(endTime: Optional<double>): SummaryTable
    - _checkInvariants(): void
    + getSummary(): SummaryTable
  }
}

' Наследование случайных законов
ArrivalLaw <|-- ExponentialInterarrivalLaw
ServiceTimeLaw <|-- UniformServiceTimeLaw

' Источники
Source --> "1" ArrivalLaw : ИЗ1
Source --> "1" EventCalendar : планирует поступления
Source ..> Request : создаёт

' Размещение заявок
PlacementDispatcher --> "1" RingBuffer : Д1ОЗ1 / Д1ОО1
PlacementDispatcher --> "1" BatchScheduler : передаёт заявку
PlacementDispatcher --> "1" Statistics : учёт приёма и вытеснения
PlacementDispatcher ..> PutResult : возвращает

RingBuffer "1" o-- "0..*" Request : ячейки
RingBuffer ..> PutResult : возвращает
PutResult --> "0..1" Request : evictedRequest

' Формирование пакетов
BatchScheduler --> "1" RingBuffer : выборка заявок
BatchScheduler --> "1" ServerDispatcher : диспетчеризация
BatchScheduler --> "1" Statistics
BatchScheduler --> "0..1" Batch : activeBatch
BatchScheduler --> "0..1" Batch : lastBatch
Batch "1" o-- "0..*" Request : pending-заявки

' Обслуживание
ServerDispatcher --> "1..*" OCRServer : Д2П1
ServerDispatcher --> "1" ServiceTimeLaw : ПЗ2
ServerDispatcher --> "1" EventCalendar : планирует завершения
ServerDispatcher --> "1" Statistics : registerStarted
OCRServer --> "0..1" Request : обслуживает

' Состояния заявок
Request --> RequestStatus

' Событийный календарь
EventCalendar "1" *-- "0..*" Event : очередь событий
Event --> EventType
Event --> "0..1" Source
Event --> "0..1" OCRServer

' Статистика
Statistics --> "0..*" Source
Statistics --> "0..*" OCRServer
Statistics "1" o-- "0..*" Request : история заявок
Statistics ..> SummaryTable : создаёт

' Контроллер
SimulationController --> "1" Config
SimulationController --> "1" StepView
SimulationController *-- EventCalendar
SimulationController *-- RingBuffer
SimulationController *-- "1..*" Source
SimulationController *-- "1..*" OCRServer
SimulationController *-- PlacementDispatcher
SimulationController *-- BatchScheduler
SimulationController *-- ServerDispatcher
SimulationController *-- Statistics

SimulationController ..> SystemState : создаёт (ОД2)
SimulationController ..> SummaryTable : возвращает (ОР1)

SystemState --> "1" SummaryTable : counters
StepView ..> SystemState : показывает
StepView ..> SummaryTable : показывает

@enduml
